# Слой хранения данных TrackTel.
# Скопируйте в client/.env.local и при необходимости измените.

# 'local' — локальный прототип (localStorage, тестовый режим).
# 'wp'    — WordPress REST API (требует VITE_WP_URL и плагин TrackTel).
VITE_DATA_BACKEND=local

# Базовый URL WordPress без слэша на конце и без /wp-json.
# Пример: https://example.com
# VITE_WP_URL=
